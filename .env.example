# Copy to .env and fill in values. NEVER commit .env.

# Deribit testnet/mainnet (primary - `nautilus-zerodte paper --config configs/profiles/paper_btc.yaml`)
DERIBIT_API_KEY=
DERIBIT_API_SECRET=
DERIBIT_TESTNET=true

# Interactive Brokers paper/live gateway (secondary - `configs/profiles/paper_spy.yaml`)
IB_HOST=
IB_PORT=
IB_CLIENT_ID=

# Where run artifacts are written: the JSONL journal, and the operator kill switch's trip
# file at <runs>/halt/<trader_id>.trip. Unset means the repo's runs/.
# The test suite sets this per test so pytest never appends to a real audit trail, and so a
# stray trip file cannot land in the operator's runs/halt/ and kill their next live session.
# MUST be a LOCAL filesystem: the trip poll is a stat inside an engine callback, and a stat
# against a hung network mount blocks the whole event loop.
ZERODTE_RUNS_DIR=
