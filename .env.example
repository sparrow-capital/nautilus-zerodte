# Copy to .env and fill in values. NEVER commit .env.

# Deribit testnet/mainnet (primary - `nautilus-zerodte paper --config configs/profiles/paper_btc.yaml`)
DERIBIT_API_KEY=
DERIBIT_API_SECRET=
DERIBIT_TESTNET=true

# Interactive Brokers paper/live gateway (secondary - `configs/profiles/paper_spy.yaml`)
IB_HOST=
IB_PORT=
IB_CLIENT_ID=

# Where run artifacts (the JSONL journal) are written. Unset means the repo's runs/.
# The test suite sets this per test so pytest never appends to a real audit trail.
ZERODTE_RUNS_DIR=
